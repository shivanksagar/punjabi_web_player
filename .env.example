# Optional: Spotify Integration (for Spotify Web Playback SDK)
# Obtain from https://developer.spotify.com/dashboard
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Optional: Vercel KV (accurate online listener count on serverless deploys)
# Create a KV store in Vercel → Storage → Create Database → KV, then copy:
KV_REST_API_URL=
KV_REST_API_TOKEN=
